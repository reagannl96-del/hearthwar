# Game server (Railway) settings. In Railway: Service -> Variables.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret   # keep secret, server only
ALLOWED_ORIGINS=https://play.yourdomain.com,https://your-project.vercel.app
# Only used when the world is first created:
WORLD_NAME=The Ashen Marches
WORLD_SPEED=150
WORLD_UNIT_SPEED=80
WORLD_SIZE=120
WORLD_AI=20
WORLD_DIFFICULTY=normal
